type u257 = U257(int)

function test(x : u257) -> unit = {
  match x {
    C42(s) => print_endline(s),
    (C257(n) : u257) => print_int("n = ", n),
    C246(_) => (),
    _ => ()
  }
}

val main : unit -> unit

function main() = {
  test(C123("Foo"));
  let x : u257 = C257(10) : u257;
  test(x);
  test(C42("Hello"));
  test(C255(255));
}
