open import Pervasives_extra
open import Sail2_values
open import Sail2_concurrency_interface_v2

type Mem_request 'addr_space 'mem_acc = Mem_request_generic (list bitU) 'addr_space 'mem_acc

val sail_mem_read : forall 'abort 'barrier 'cache_op 'exn 'pa 'tlb_op 'trans_start 'trans_end 'mem_acc 'addr 'addr_space 'regval 'e.
  Mem_request_generic 'addr 'addr_space 'mem_acc ->
  monad 'abort 'barrier 'cache_op 'exn 'tlb_op 'trans_start 'trans_end 'mem_acc 'addr 'addr_space 'regval (result (list (list bitU) * list bool) 'abort) 'e
let sail_mem_read req =
  let k = function
    | Ok (res, tag) -> return (Ok (List.map bits_of res, tag))
    | Err e -> return (Err e)
  end in
  Mem_read req k

val sail_mem_write : forall 'abort 'barrier 'cache_op 'exn 'pa 'tlb_op 'trans_start 'trans_end 'mem_acc 'addr 'addr_space 'regval 'e.
  Mem_request_generic 'addr 'addr_space 'mem_acc ->
  list (list bitU) ->
  list bool ->
  monad 'abort 'barrier 'cache_op 'exn 'tlb_op 'trans_start 'trans_end 'mem_acc 'addr 'addr_space 'regval (result unit 'abort) 'e
let sail_mem_write req data tags =
  match just_list (List.map of_bits data) with
  | Just bytes -> Mem_write req bytes tags return
  | Nothing -> Fail "sail_mem_write given bad value"
  end
