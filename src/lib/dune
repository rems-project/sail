(env
 (dev
  (flags
   (:standard %{dune-warnings} -w -69 -w -67 -w -33 -w -27)))
 (release
  (flags
   (:standard %{dune-warnings} -w -69 -w -67 -w -33 -w -27))))

(rule
 (target jib.ml)
 (deps
  (:jib_ott ../../language/jib.ott))
 (action
  (run
   ott
   -sort
   false
   -generate_aux_rules
   true
   -o
   %{target}
   -picky_multiple_parses
   true
   %{jib_ott})))

(rule
 (target corelib_sail.ml)
 (deps
  (:corelib_sail ../../lib/core/corelib.sail))
 (action
  (with-stdout-to
   corelib_sail.ml
   (run
    sail_maker
    embed
    --file
    %{corelib_sail}
    --virtual-file
    "corelib.sail"))))

(rule
 (target corelib_project.ml)
 (deps
  (:corelib_project ../../lib/core/corelib.sail_project))
 (action
  (with-stdout-to
   corelib_project.ml
   (run
    sail_maker
    embed
    --file
    %{corelib_project}
    --virtual-file
    "corelib.sail_project"))))

; sail_lib.mli is generated from the externs in the Sail library
; (externs.json), so the OCaml interface to the library primitives is
; always kept in sync with the library. See `make externs`.

(rule
 (target sail_lib.mli)
 (deps
  (:externs externs.json)
  (:header sail_lib_header.mli.in)
  (:overrides sail_lib_overrides.json))
 (action
  (with-stdout-to
   %{target}
   (run
    sail_maker
    gen_sail_lib_mli
    --externs
    %{externs}
    --header
    %{header}
    --overrides
    %{overrides}))))

(include_subdirs qualified)

(menhir
 (modules parser)
 (flags --external-tokens Token))

(menhir
 (modules infix_parser)
 (flags --table --external-tokens Infix_parser_token))

(menhir
 (modules project_parser)
 (flags --external-tokens Project_token))

(ocamllex lexer project_lexer)

(generate_sites_module
 (module libsail_sites)
 (sites libsail))

; The parallel implementation of map uses effect handlers and matching
; syntax, which is only available from OCaml 5.3.0 onwards. On older
; compilers fall back to a sequential implementation.

(rule
 (target parmap.ml)
 (enabled_if
  (>= %{ocaml_version} 5.3.0))
 (deps parmap.par.ml)
 (action
  (copy parmap.par.ml parmap.ml)))

(rule
 (target parmap.ml)
 (enabled_if
  (< %{ocaml_version} 5.3.0))
 (deps parmap.seq.ml)
 (action
  (copy parmap.seq.ml parmap.ml)))

