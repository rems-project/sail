 (name libsail)
 (public_name libsail)
 (libraries zarith linksem pprint dune-site yojson menhirLib)
 (modes byte native)
 (instrumentation
  (backend bisect_ppx --exclusions src/lib/bisect.exclude)
  (deps bisect.exclude)))
